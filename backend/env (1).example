# ASSI Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — only this .env.example file.

# ─── App ────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3001
# Production: FRONTEND_URL=https://myassi.app,https://www.myassi.app

# ─── Supabase ───────────────────────────────────
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Database (Prisma) ──────────────────────────
# For local dev / db pull → use direct connection (port 5432)
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
#
# For production (Railway) → use the pooler (port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ─── Redis ──────────────────────────────────────
# Railway adds this automatically when you attach the Redis plugin
REDIS_URL=redis://localhost:6379

# ─── AI Layer ───────────────────────────────────
# OpenAI — used by ASSI guest service + Sentinel
OPENAI_API_KEY=sk-...

# Claude — future replacement for OpenAI layer
# CLAUDE_API_KEY=sk-ant-...
