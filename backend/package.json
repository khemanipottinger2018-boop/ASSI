{
  "name": "assi-backend",
  "version": "1.0.0",
  "description": "ASSI Platform Backend - Academic Support & Study Initiative",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/app.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/app.js",
    "start:dev": "cross-env NODE_ENV=development node dist/app.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "tutoring",
    "education",
    "websocket",
    "api",
    "real-time",
    "academic"
  ],
  "author": "ASSI Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^7.5.0",
    "@socket.io/redis-adapter": "^8.2.0",
    "@supabase/supabase-js": "^2.99.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.15.0",
    "redis": "^5.10.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/assi-backend.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/assi-backend/issues"
  },
  "homepage": "https://assi.app"
}
